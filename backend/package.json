{
  "name": "nodejs-backend",
  "version": "1.0.0",
  "description": "Simple Node.js API server for AWS EC2",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start server.js --name 'api-server'",
    "pm2:stop": "pm2 stop api-server",
    "pm2:restart": "pm2 restart api-server",
    "pm2:delete": "pm2 delete api-server"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "nodejs",
    "express",
    "api",
    "aws",
    "ec2"
  ],
  "author": "Your Name",
  "license": "MIT"
}
